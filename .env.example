# Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Secret untuk menandatangani session cookie (random string panjang)
AUTH_SECRET=your-random-secret-min-32-chars

# Payment Gateways
# Midtrans mendukung dua mode sekaligus: isi key production DAN sandbox agar bisa
# di-switch dari dashboard (Pembayaran → mode Sandbox/Production) tanpa ganti env.
# Server Key sandbox diawali SB-, production diawali VT- (mismatch → 401 Unauthorized).
MIDTRANS_SERVER_KEY=VT-your-production-server-key
MIDTRANS_CLIENT_KEY=Mid-your-production-client-key
MIDTRANS_SERVER_KEY_SANDBOX=SB-your-sandbox-server-key
MIDTRANS_CLIENT_KEY_SANDBOX=SB-Mid-your-sandbox-client-key
# Default mode bila creator belum memilih di dashboard (fallback konfigurasi lama)
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_CALLBACK_TOKEN=your-xendit-callback-token

# Email Delivery (Resend)
RESEND_API_KEY=your-resend-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
