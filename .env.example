# Turso (libSQL)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Secret untuk menandatangani session cookie (random string panjang)
AUTH_SECRET=your-random-secret-min-32-chars

# Payment Gateways
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# true = produksi, false = sandbox (fallback lama: MIDTRANS_ENVIRONMENT=SANDBOX|PRODUCTION)
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_CALLBACK_TOKEN=your-xendit-callback-token

# Email Delivery (Resend)
RESEND_API_KEY=your-resend-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
